# Kubernetes Reliability Platform — Environment Configuration
# Copy this file to .env and replace placeholder values.
# Never commit real secrets or credentials.

# =============================================================================
# Application
# =============================================================================

APP_ENV=development
LOG_LEVEL=info
SERVICE_NAME=user-service
HOST=0.0.0.0
PORT=8001

# =============================================================================
# Database
# =============================================================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=k8s_reliability
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me

# Optional: override component-based URL with a full connection string
# DATABASE_URL=postgresql+psycopg2://app_user:change_me@localhost:5432/k8s_reliability

# =============================================================================
# Service URLs (planned — Milestone 2+)
# =============================================================================

# ORDER_SERVICE_URL=http://localhost:8002
PAYMENT_SERVICE_URL=http://127.0.0.1:8003
PAYMENT_SERVICE_TIMEOUT_SECONDS=5.0

# =============================================================================
# Observability (planned — Milestones 7–10)
# =============================================================================

# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# PROMETHEUS_URL=http://localhost:9090
# GRAFANA_URL=http://localhost:3000

# =============================================================================
# AI Layer (planned — Milestones 14–17)
# =============================================================================

# LLM_API_KEY=your_api_key_here
# LLM_MODEL=gpt-4
# AI_K8S_READONLY=true
# AI_REMEDIATION_ENABLED=false
