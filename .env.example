# Kubernetes Reliability Platform — Environment Configuration
# Copy this file to .env and replace placeholder values.
# Never commit real secrets or credentials.

# =============================================================================
# Application
# =============================================================================

APP_ENV=development
LOG_LEVEL=info
SERVICE_NAME=user-service
HOST=0.0.0.0
PORT=8001

# =============================================================================
# Database
# =============================================================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=k8s_reliability
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me

# Optional: override component-based URL with a full connection string
# DATABASE_URL=postgresql+psycopg2://app_user:change_me@localhost:5432/k8s_reliability

# =============================================================================
# Service URLs (planned — Milestone 2+)
# =============================================================================

# ORDER_SERVICE_URL=http://localhost:8002
PAYMENT_SERVICE_URL=http://127.0.0.1:8003
PAYMENT_SERVICE_TIMEOUT_SECONDS=5.0

# =============================================================================
# Observability — Application Services (Milestones 7–10)
# =============================================================================
# Distributed tracing (Milestone 10 — requires OpenTelemetry Collector in cluster)
OTEL_TRACES_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# =============================================================================
# Observability BFF (Milestone 14 — services/observability_api/)
# =============================================================================
# Used when running the Observability BFF locally. Requires kubectl port-forwards
# to in-cluster Prometheus, Loki, Tempo, and Alertmanager (see docs/DEVELOPMENT.md).
#
# SERVICE_NAME=observability-api
# HOST=0.0.0.0
# PORT=8004
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200
ALERTMANAGER_URL=http://localhost:9093
# UPSTREAM_TIMEOUT_SECONDS=5.0
# UPSTREAM_CONNECT_TIMEOUT_SECONDS=2.0

# Grafana (optional — not required for M14 console; useful for dashboard comparison)
# GRAFANA_URL=http://localhost:3000

# =============================================================================
# Runbook Knowledge Assistant (planned — Milestone 15)
# =============================================================================

# LLM_API_KEY=your_api_key_here
# LLM_MODEL=gpt-4
